{
  "version": 2,
  "builds": [
    {
      "src": "FRONTEND/Speech Disorder Detection/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "FRONTEND/Speech Disorder Detection/assets/$1"
    },
    {
      "src": "/(favicon\\..*|icons\\..*|_redirects)",
      "dest": "FRONTEND/Speech Disorder Detection/$1"
    },
    {
      "src": "/(.*)",
      "dest": "FRONTEND/Speech Disorder Detection/index.html"
    }
  ]
}
